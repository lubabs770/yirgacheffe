# Copy to tools/link.env (gitignored) and fill in for your own setup.

# Where the tailnet publishes the board, used by `tools/ota.sh --remote`.
ZENITH_REMOTE_URL="http://<your-host>.<your-tailnet>.ts.net:8080"

# A device on the board's LAN, reachable over the tailnet, used as a fallback
# tunnel when the board is not on the same network as this machine. Leave unset
# to disable the tunnel and use the direct hop only.
PHONE_USER=""
PHONE_HOST=""
PHONE_PORT="8022"
